// use prisma-next

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  HR
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Interview {
  id            Uuid                @id @default(uuid())
  type          InterviewType
  difficulty    InterviewDifficulty
  focusArea     String
  questionCount Int
  status        InterviewStatus     @default(NOT_STARTED)
  createdAt     DateTime            @default(now())
  updatedAt     temporal.updatedAt()
  questions     Question[]
}

model Question {
  id           Uuid      @id @default(uuid())
  interviewId  Uuid
  interview    Interview @relation(fields: [interviewId], references: [id])
  questionText String
  orderIndex   Int
  createdAt    DateTime  @default(now())
  updatedAt    temporal.updatedAt()
  answer       Answer?
}

model Answer {
  id           Uuid      @id @default(uuid())
  questionId   Uuid      @unique
  question     Question  @relation(fields: [questionId], references: [id])
  answerText   String
  submittedAt  DateTime  @default(now())
}
