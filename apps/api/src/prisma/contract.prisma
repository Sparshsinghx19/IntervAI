// use prisma-next

enum InterviewType {
  TECHNICAL
  BEHAVIORAL
  HR
}

enum InterviewDifficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Interview {
  id               Uuid                @id @default(uuid())
  type             InterviewType
  difficulty       InterviewDifficulty
  focusArea        String
  questionCount    Int
  status           InterviewStatus     @default(NOT_STARTED)
  createdAt        DateTime            @default(now())
  updatedAt        temporal.updatedAt()
  questions        Question[]
  evaluationReport EvaluationReport?
  codeSubmissions  CodeSubmission[]
}

enum QuestionType {
  THEORY
  CODING
  SYSTEM_DESIGN
}

model Question {
  id                Uuid             @id @default(uuid())
  interviewId       Uuid
  interview         Interview        @relation(fields: [interviewId], references: [id])
  questionText      String
  orderIndex        Int
  type              QuestionType     @default(THEORY)
  codingProblemSlug String?
  createdAt         DateTime         @default(now())
  updatedAt         temporal.updatedAt()
  answer            Answer?
  submissions       CodeSubmission[]
}

enum EvaluationStatus {
  PENDING
  COMPLETED
  FAILED
}

model Answer {
  id           Uuid        @id @default(uuid())
  questionId   Uuid        @unique
  question     Question    @relation(fields: [questionId], references: [id])
  answerText   String
  submittedAt  DateTime    @default(now())
  evaluation   Evaluation?
}

model Evaluation {
  id                Uuid             @id @default(uuid())
  answerId          Uuid             @unique
  answer            Answer           @relation(fields: [answerId], references: [id])
  status            EvaluationStatus @default(PENDING)
  correctnessScore  Int?
  completenessScore Int?
  reasoningScore    Int?
  clarityScore      Int?
  overallScore      Int?
  summary           String?
  strengths         Json?
  improvements      Json?
  sampleAnswer      String?
  createdAt         DateTime         @default(now())
  updatedAt         temporal.updatedAt()
}

model EvaluationReport {
  id                 Uuid             @id @default(uuid())
  interviewId        Uuid             @unique
  interview          Interview        @relation(fields: [interviewId], references: [id])
  status             EvaluationStatus @default(PENDING)
  overallScore       Int?
  performanceLevel   String?
  summary            String?
  questionsEvaluated Int?
  reportPayload      Json?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  updatedAt          temporal.updatedAt()
}

model CodeSubmission {
  id              Uuid      @id @default(uuid())
  interviewId     Uuid
  interview       Interview @relation(fields: [interviewId], references: [id])
  questionId      Uuid
  question        Question  @relation(fields: [questionId], references: [id])
  language        String
  sourceCode      String
  status          String
  testsPassed     Int
  totalTests      Int
  executionTimeMs Int?
  memoryKb        Int?
  testResults     Json?
  createdAt       DateTime  @default(now())
}

model CodingTestCase {
  id             Uuid     @id @default(uuid())
  problemSlug    String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
  orderIndex     Int
  createdAt      DateTime @default(now())
}
