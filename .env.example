POSTGRES_USER=intervai_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=intervai

# Production: keep Neon URLs in the Git-ignored .env.production.local:
#   DATABASE_URL = pooled connection (runtime), DIRECT_URL = direct connection (migrations).
# Run production migrations with PRISMA_ENV_FILE=.env.production.local npx prisma db migrate
DATABASE_URL=postgres://intervai_user:your_secure_password_here@localhost:5432/intervai?schema=public
GEMINI_API_KEY=your_actual_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
QDRANT_URL=https://your-qdrant-cluster-endpoint
QDRANT_API_KEY=your_actual_qdrant_api_key

# Judge0 Code Execution Runner
# Note: On local Windows Docker / WSL2 environments, C++ and Python are verified.
# Java execution requires a dedicated Linux host with full cgroups v1 isolate support and is disabled on local WSL2.
# Local runner applies per-process limits; production deployments must enforce aggregate cgroup sandbox isolation.
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token

# Set to false when no isolated production runner is available (reduced beta):
# coding questions are then answered in text and Run/Submit never reach a runner.
CODE_EXECUTION_ENABLED=true

# Authentication
# Exact browser origin(s) of the web app, comma-separated. Used for credentialed CORS and the CSRF origin check.
FRONTEND_ORIGINS=http://localhost:3000
# Session lifetime in hours (enforced server-side). Default: 168 (7 days).
AUTH_SESSION_TTL_HOURS=168
# lax (default) works when web and API share a site (e.g. localhost:3000 + localhost:4000).
# Use none only for cross-site deployments; it forces the Secure flag.
AUTH_COOKIE_SAMESITE=lax
# Set when the API runs behind a reverse proxy so rate limiting sees real client IPs (e.g. 1).
TRUST_PROXY=
# Web app: base URL of the API. Use "same-origin" in production with API_PROXY_TARGET,
# so the browser calls this site's /api path and Next.js proxies it to the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Web app (production): origin of the Express API that /api is proxied to, e.g. https://intervai-api.onrender.com
API_PROXY_TARGET=
